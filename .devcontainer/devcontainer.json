{
  "name": "GadgetInspectra ROS 2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "twxs.cmake",
        "redhat.vscode-yaml"
      ]
    }
  },
  "containerEnv": {
    "ROS_DISTRO": "jazzy"
  },
  "remoteUser": "root"
}